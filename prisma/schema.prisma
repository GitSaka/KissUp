generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum NotificationType {
  LIKE
  VISIT
  SYSTEM
}

enum RelationshipGoal {
  LONG_TERM
  SHORT_TERM
  FRIENDSHIP
  CASUAL
  NOT_SURE
}

enum CallType {
  AUDIO
  VIDEO
}

enum TabCategory {
  RECOMMENDED
  NEW
  FEATURED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  STICKER
}

enum MomentType {
  TEXT_ONLY
  PHOTO
  VIDEO
}

enum TransactionType {
  TOPUP          // Achat de coins via FedaPay / CinetPay (Argent réel -> Coins)
  GIFT_SEND      // Dépense de coins pour envoyer un cadeau
  GIFT_RECEIVE   // Réception de diamants suite à un cadeau reçu
  CALL_SPEND     // Dépense pour un appel payant
  MESSAGE_SPEND  // Dépense pour un message payant
  WITHDRAWAL     // Retrait de diamants vers de l'argent réel (Mobile Money)
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ==================== MODELS ====================

model User {
  id               String            @id @default(uuid())
  phone            String?           @unique
  email            String?           @unique
  password         String
  nickname         String
  avatar           String?
  
  gender           Gender            @default(MALE)
  interestedIn     Gender?           
  bio              String?

  // Champs narratifs
  lifeStory        String?           @db.Text
  studyPath        String?           @db.Text
  idealPartner     String?

  primarySchool    String?
  highSchool       String?
  university       String?
  favoriteFood     String?
  passion          String?
  futureMotivation String?
  
  // Infos physiques & géoloc
  age              Int?
  height           String?
  city             String?
  country          String?
  continent        String?
  maritalStatus    String?
  relationGoal     RelationshipGoal? @default(LONG_TERM)

  // 💰 Soldes financiers & Niveaux (🚀 Cadeau de 1000 pièces à l'inscription)
  coins            Int               @default(1000)
  diamonds         Int               @default(0)
  wealthLevel      Int               @default(1)
  charmLevel       Int               @default(1)
  isVip            Boolean           @default(false)
  
  isOnline         Boolean           @default(false)
  lastSeen         DateTime          @default(now())

  distance         String?           @default("1.0 km")
  isVerified       Boolean           @default(false)
  activeCall       CallType?
  tabCategory      TabCategory       @default(RECOMMENDED)

  // 🚀 Arsenal stratégique & Système
  isBot            Boolean           @default(false) 
  botStep          Int               @default(0)     
  pushToken        String?                     

  // Relations sociales
  sentInteractions     UserInteraction[] @relation("SentInteractions")
  receivedInteractions UserInteraction[] @relation("ReceivedInteractions")
  
  sentMessages         Message[]         @relation("SentMessages")
  receivedMessages     Message[]         @relation("ReceivedMessages")

  moments              Moment[]
  momentLikes          MomentLike[]
  momentComments       MomentComment[]
  photos               UserPhoto[]       @relation("UserGallery")

  following            Follow[]          @relation("UserFollowing")
  followers            Follow[]          @relation("UserFollowers")
  
  visitors             ProfileVisitor[]  @relation("VisitorRelation")
  visiteds             ProfileVisitor[]  @relation("VisitedRelation")

  receivedNotifications Notification[] @relation("NotificationReceiver")
  sentNotifications     Notification[] @relation("NotificationSender")

  // 🚀 Lignes réciproques pour le compteur anti-spam
  botTriggersReceived BotTrigger[] @relation("BoyTriggers")
  botActionsSent      BotTrigger[] @relation("BotActions")


  // 💰 Relations financières
  transactions         Transaction[]     @relation("UserTransactions")
  targetTransactions   Transaction[]     @relation("TargetUserTransactions")
  sentGifts            GiftTransaction[] @relation("SentGifts")
  receivedGifts        GiftTransaction[] @relation("ReceivedGifts")
  withdrawals          WithdrawalRequest[] @relation("UserWithdrawals")

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("users")
}

// ==================== CENTRE DE NOTIFICATIONS ====================

model Notification {
  id          String           @id @default(uuid())
  receiverId  String           // Celui qui reçoit la pastille rouge
  senderId    String?          // L'auteur de l'action (ou null si SYSTEM)
  type        NotificationType // LIKE, VISIT, SYSTEM
  title       String           // Le titre de l'alerte
  content     String           // Le texte de l'alerte
  actionUrl   String?          // 🚀 L'URL cliquable pour Expo Router (ex: /profile/user_id)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  // 🔗 Relations Prisma pour inclure les infos utilisateur
  receiver    User             @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      User?            @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// ==================== SECTIONS SOCIALES ====================

model ProfileVisitor {
  id         String   @id @default(uuid())
  visitorId  String   
  visitedId  String   
  visitedAt  DateTime @default(now()) 

  visitor    User     @relation("VisitorRelation", fields: [visitorId], references: [id], onDelete: Cascade)
  visited    User     @relation("VisitedRelation", fields: [visitedId], references: [id], onDelete: Cascade)

  @@map("profile_visitors")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

model UserInteraction {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("liked")
  
  sender     User     @relation("SentInteractions", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedInteractions", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
  @@map("user_interactions")
}

// ==================== COMPTEUR STRATÉGIQUE ANTI-SPAM ====================

// ==================== COMPTEUR STRATÉGIQUE ANTI-SPAM ====================

model BotTrigger {
  id         String   @id @default(uuid())
  userId     String   // L'ID du vrai garçon qui reçoit l'hameçon
  botId      String   // L'ID du robot femme qui a pris l'initiative d'écrire
  createdAt  DateTime @default(now())

  // 🔗 Relations explicites vers la table "users"
  user       User     @relation("BoyTriggers", fields: [userId], references: [id], onDelete: Cascade)
  bot        User     @relation("BotActions", fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_triggers")
}



model Message {
  id              String      @id @default(uuid())
  senderId        String
  receiverId      String

  type            MessageType @default(TEXT)
  content         String?
  mediaUrl        String?
  durationSeconds Int?

  isRead          Boolean     @default(false)

  sender          User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt       DateTime    @default(now())

  @@map("messages")
}

model Moment {
  id             String      @id @default(uuid())
  userId         String
  content        String?
  type           MomentType  @default(TEXT_ONLY)
  mediaUrls      String[]
  duration       String?
  isSponsored    Boolean     @default(false)
  sponsoredUntil DateTime?       
  isVipPost      Boolean     @default(false)
  
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes          MomentLike[]
  comments       MomentComment[]
  giftTransactions GiftTransaction[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("moments")
}

model MomentLike {
  id       String @id @default(uuid())
  momentId String
  userId   String

  moment   Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([momentId, userId])
  @@map("moment_likes")
}

model MomentComment {
  id       String   @id @default(uuid())
  momentId String
  userId   String
  text     String

  moment   Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("moment_comments")
}

model UserPhoto {
  id       String @id @default(uuid())
  userId   String
  imageUrl String

  user     User   @relation("UserGallery", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("user_photos")
}

// ==================== 💰 MODULE FINANCIER COMPLET ====================

model Gift {
  id           String            @id @default(uuid())
  name         String            
  priceInCoins Int               
  iconUrl      String            
  category     String?           @default("standard")
  isActive     Boolean           @default(true)

  transactions GiftTransaction[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("gifts")
}

model Transaction {
  id               String            @id @default(uuid())
  userId           String            
  targetUserId     String?           
  type             TransactionType   
  amountCoins      Int?              
  amountDiamonds   Int?              
  fiatAmount       Float?            
  fiatCurrency     String?           @default("XOF")
  gateway          String?           
  gatewayReference String?           @unique 
  status           TransactionStatus @default(PENDING)
  description      String?

  user             User              @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  targetUser       User?             @relation("TargetUserTransactions", fields: [targetUserId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("transactions")
}

model GiftTransaction {
  id            String   @id @default(uuid())
  senderId      String
  receiverId    String
  giftId        String
  momentId      String?
  quantity      Int      @default(1)
  totalCoins    Int      
  totalDiamonds Int      

  sender        User     @relation("SentGifts", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User     @relation("ReceivedGifts", fields: [receiverId], references: [id], onDelete: Cascade)
  gift          Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  moment        Moment?  @relation(fields: [momentId], references: [id], onDelete: SetNull) 

  createdAt     DateTime @default(now())

  @@map("gift_transactions")
}

model WithdrawalRequest {
  id             String           @id @default(uuid())
  userId         String
  diamondsAmount Int              
  fiatAmount     Float            
  phoneNumber    String           
  provider       String           
  status         WithdrawalStatus @default(PENDING)
  adminNote      String?

  user           User             @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("withdrawal_requests")
}