generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RelationshipGoal {
  LONG_TERM
  SHORT_TERM
  FRIENDSHIP
  CASUAL
  NOT_SURE
}

enum CallType {
  AUDIO
  VIDEO
}

enum TabCategory {
  RECOMMENDED
  NEW
  FEATURED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  STICKER
}

// Nouvel enum pour typer les publications Moments
enum MomentType {
  TEXT_ONLY
  PHOTO
  VIDEO
}

model User {
  id           String      @id @default(uuid())
  phone        String?     @unique
  email        String?     @unique
  password     String
  nickname     String
  avatar       String?
  
  gender       Gender      @default(MALE)
  interestedIn    Gender?           // Genre recherché
  bio          String?

  // Nouveaux champs narratifs
  lifeStory       String?           @db.Text // Son histoire
  studyPath       String?           @db.Text // Son parcours d'études / professionnel
  idealPartner    String?

  primarySchool   String?           // Où avez-vous fait votre école primaire ?
  highSchool      String?           // Où avez-vous fait votre cours secondaire ?
  university      String?           // Votre parcours universitaire ?
  favoriteFood    String?           // Votre nourriture préférée ?
  passion         String?           // Votre passion principale ?
  futureMotivation String?          // Votre motivation pour l'avenir ?
  
  
  // Nouveaux champs de profil demandés
  age          Int?
  height       String?     // ex: "1.82 m"
  city         String?     // ex: "Porto-Novo"
  country      String?     // ex: "Bénin"
  continent    String?     // ex: "Afrique"
  maritalStatus String?    // ex: "Célibataire"
  relationGoal RelationshipGoal? @default(LONG_TERM) // Prêt(e) pour une relation amoureuse / type de recherche

  coins        Int         @default(0)
  diamonds     Int         @default(0)
  
  wealthLevel  Int         @default(1)
  charmLevel   Int         @default(1)
  isVip        Boolean     @default(false)
  
  isOnline     Boolean     @default(false)
  lastSeen     DateTime    @default(now())

  distance     String?     @default("1.0 km")
  isVerified   Boolean     @default(false)
  activeCall   CallType?
  tabCategory  TabCategory @default(RECOMMENDED)

  // Relations existantes
  sentInteractions     UserInteraction[] @relation("SentInteractions")
  receivedInteractions UserInteraction[] @relation("ReceivedInteractions")
  
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  // Nouvelles relations pour les Moments et le Profil
  moments          Moment[]
  momentLikes      MomentLike[]
  momentComments   MomentComment[]
  photos           UserPhoto[]   @relation("UserGallery")

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  following   Follow[] @relation("UserFollowing")
  followers   Follow[] @relation("UserFollowers")

  @@map("users")
}


model Follow {
  id          String   @id @default(uuid())
  followerId  String   // Celui qui s'abonne
  followingId String   // Celui qui est suivi
  
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

model UserInteraction {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("liked")
  
  sender     User     @relation("SentInteractions", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedInteractions", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
  @@map("user_interactions")
}

model Message {
  id              String      @id @default(uuid())
  senderId        String
  receiverId      String

  type            MessageType @default(TEXT)
  content         String?
  mediaUrl        String?
  durationSeconds Int?

  isRead          Boolean     @default(false)

  sender          User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt       DateTime    @default(now())

  @@map("messages")
}

// 📌 NOUVEAU : Modèle pour les publications "Moments"
model Moment {
  id           String        @id @default(uuid())
  userId       String
  content      String
  type         MomentType    @default(TEXT_ONLY)
  mediaUrls    String[]      // Tableau d'URLs pour les photos/vidéos
  duration     String?       // Durée pour les vidéos (ex: "0:45")
  
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes        MomentLike[]
  comments     MomentComment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("moments")
}

// 📌 NOUVEAU : Likes sur les Moments
model MomentLike {
  id       String @id @default(uuid())
  momentId String
  userId   String

  moment   Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([momentId, userId])
  @@map("moment_likes")
}

// 📌 NOUVEAU : Commentaires sur les Moments
model MomentComment {
  id        String   @id @default(uuid())
  momentId  String
  userId    String
  text      String

  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("moment_comments")
}

// 📌 NOUVEAU : Galerie photos supplémentaire pour la page de profil
model UserPhoto {
  id       String @id @default(uuid())
  userId   String
  imageUrl String

  user     User   @relation("UserGallery", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("user_photos")
}