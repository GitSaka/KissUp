generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CallType {
  AUDIO
  VIDEO
}

enum TabCategory {
  RECOMMENDED
  NEW
  FEATURED
}

// 👇 Nouvel enum pour typer le contenu d'un message
enum MessageType {
  TEXT
  IMAGE
  VIDEO
}

model User {
  id           String      @id @default(uuid())
  phone        String?     @unique
  email        String?     @unique
  password     String
  nickname     String
  avatar       String?
  
  gender       Gender      @default(MALE)
  bio          String?
  
  coins        Int         @default(0)
  diamonds     Int         @default(0)
  
  wealthLevel  Int         @default(1)
  charmLevel   Int         @default(1)
  isVip        Boolean     @default(false)
  
  isOnline     Boolean     @default(false)
  lastSeen     DateTime    @default(now())

  distance     String?     @default("1.0 km")
  isVerified   Boolean     @default(false)
  activeCall   CallType?
  tabCategory  TabCategory @default(RECOMMENDED)

  sentInteractions     UserInteraction[] @relation("SentInteractions")
  receivedInteractions UserInteraction[] @relation("ReceivedInteractions")
  
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("users")
}

model UserInteraction {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("liked")
  
  sender     User     @relation("SentInteractions", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedInteractions", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
  @@map("user_interactions")
}

// Table pour les messages de l'onglet Chat/Messages
model Message {
  id         String      @id @default(uuid())
  senderId   String
  receiverId String

  type       MessageType @default(TEXT)  // 👈 nouveau : TEXT, IMAGE ou VIDEO
  content    String?                      // 👈 devient optionnel : texte du message (null si image/vidéo pure)
  mediaUrl   String?                      // 👈 nouveau : URL Cloudinary si type = IMAGE ou VIDEO

  isRead     Boolean     @default(false)

  sender     User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt  DateTime    @default(now())

  @@map("messages")
}