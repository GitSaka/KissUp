generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RelationshipGoal {
  LONG_TERM
  SHORT_TERM
  FRIENDSHIP
  CASUAL
  NOT_SURE
}

enum CallType {
  AUDIO
  VIDEO
}

enum TabCategory {
  RECOMMENDED
  NEW
  FEATURED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  STICKER
}

enum MomentType {
  TEXT_ONLY
  PHOTO
  VIDEO
}

// 💰 Enums financiers
enum TransactionType {
  TOPUP            // Achat de coins via FedaPay / CinetPay (Argent réel -> Coins)
  GIFT_SEND        // Dépense de coins pour envoyer un cadeau
  GIFT_RECEIVE     // Réception de diamants suite à un cadeau reçu
  CALL_SPEND       // Dépense pour un appel payant
  MESSAGE_SPEND    // Dépense pour un message payant
  WITHDRAWAL       // Retrait de diamants vers de l'argent réel (Mobile Money)
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ==================== MODELS ====================

model User {
  id               String            @id @default(uuid())
  phone            String?           @unique
  email            String?           @unique
  password         String
  nickname         String
  avatar           String?
  
  gender           Gender            @default(MALE)
  interestedIn     Gender?           
  bio              String?

  // Champs narratifs
  lifeStory        String?           @db.Text
  studyPath        String?           @db.Text
  idealPartner     String?

  primarySchool    String?
  highSchool       String?
  university       String?
  favoriteFood     String?
  passion          String?
  futureMotivation String?
  
  // Infos physiques & géoloc
  age              Int?
  height           String?
  city             String?
  country          String?
  continent        String?
  maritalStatus    String?
  relationGoal     RelationshipGoal? @default(LONG_TERM)

  // 💰 Soldes financiers & Niveaux
  coins            Int               @default(0)
  diamonds         Int               @default(0)
  wealthLevel      Int               @default(1)
  charmLevel       Int               @default(1)
  isVip            Boolean           @default(false)
  
  isOnline         Boolean           @default(false)
  lastSeen         DateTime          @default(now())

  distance         String?           @default("1.0 km")
  isVerified       Boolean           @default(false)
  activeCall       CallType?
  tabCategory      TabCategory       @default(RECOMMENDED)

  // Relations sociales existantes
  sentInteractions     UserInteraction[] @relation("SentInteractions")
  receivedInteractions UserInteraction[] @relation("ReceivedInteractions")
  
  sentMessages         Message[]         @relation("SentMessages")
  receivedMessages     Message[]         @relation("ReceivedMessages")

  moments              Moment[]
  momentLikes          MomentLike[]
  momentComments       MomentComment[]
  photos               UserPhoto[]       @relation("UserGallery")

  following            Follow[]          @relation("UserFollowing")
  followers            Follow[]          @relation("UserFollowers")

  // 💰 Nouvelles relations financières
  transactions         Transaction[]     @relation("UserTransactions")
  targetTransactions   Transaction[]     @relation("TargetUserTransactions")
  sentGifts            GiftTransaction[] @relation("SentGifts")
  receivedGifts        GiftTransaction[] @relation("ReceivedGifts")
  withdrawals          WithdrawalRequest[] @relation("UserWithdrawals")

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("users")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

model UserInteraction {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("liked")
  
  sender     User     @relation("SentInteractions", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedInteractions", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
  @@map("user_interactions")
}

model Message {
  id              String      @id @default(uuid())
  senderId        String
  receiverId      String

  type            MessageType @default(TEXT)
  content         String?
  mediaUrl        String?
  durationSeconds Int?

  isRead          Boolean     @default(false)

  sender          User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt       DateTime    @default(now())

  @@map("messages")
}

model Moment {
  id         String       @id @default(uuid())
  userId     String
  content    String
  type       MomentType   @default(TEXT_ONLY)
  mediaUrls  String[]
  duration   String?
  
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      MomentLike[]
  comments   MomentComment[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("moments")
}

model MomentLike {
  id       String @id @default(uuid())
  momentId String
  userId   String

  moment   Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([momentId, userId])
  @@map("moment_likes")
}

model MomentComment {
  id        String   @id @default(uuid())
  momentId  String
  userId    String
  text      String

  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("moment_comments")
}

model UserPhoto {
  id       String @id @default(uuid())
  userId   String
  imageUrl String

  user     User   @relation("UserGallery", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("user_photos")
}

// ==================== 💰 MODULE FINANCIER ====================

// Catalogue des Cadeaux Virtuels
model Gift {
  id           String            @id @default(uuid())
  name         String            // Nom du cadeau (ex: "Rose", "Voiture")
  priceInCoins Int               // Coût d'achat en coins
  iconUrl      String            // URL de l'image ou de l'animation
  category     String?           @default("standard")
  isActive     Boolean           @default(true)

  transactions GiftTransaction[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("gifts")
}

// Journal de bord (Ledger) de toutes les opérations financières de la plateforme
model Transaction {
  id               String            @id @default(uuid())
  userId           String            // L'acteur principal (celui qui initie ou reçoit)
  targetUserId     String?           // Optionnel : L'autre utilisateur impliqué
  
  type             TransactionType   // TOPUP, GIFT_SEND, GIFT_RECEIVE, etc.
  amountCoins      Int?              // Mouvement de coins (+ ou -)
  amountDiamonds   Int?              // Mouvement de diamants (+ ou -)
  fiatAmount       Float?            // Montant en argent réel (FedaPay / CinetPay)
  fiatCurrency     String?           @default("XOF")
  
  gateway          String?           // "fedapay" ou "cinetpay"
  gatewayReference String?           @unique // ID de transaction externe unique
  
  status           TransactionStatus @default(PENDING)
  description      String?

  user             User              @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  targetUser       User?             @relation("TargetUserTransactions", fields: [targetUserId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("transactions")
}

// Liaison précise d'un envoi de cadeau entre deux utilisateurs
model GiftTransaction {
  id            String   @id @default(uuid())
  senderId      String
  receiverId    String
  giftId        String
  quantity      Int      @default(1)
  totalCoins    Int      // Coût total en coins
  totalDiamonds Int      // Diamants reversés au receveur

  sender        User     @relation("SentGifts", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User     @relation("ReceivedGifts", fields: [receiverId], references: [id], onDelete: Cascade)
  gift          Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@map("gift_transactions")
}

// Demandes de retrait (Payout) de diamants vers Mobile Money
model WithdrawalRequest {
  id             String           @id @default(uuid())
  userId         String
  diamondsAmount Int              // Nombre de diamants convertis
  fiatAmount     Float            // Équivalent en monnaie réelle (XOF)
  phoneNumber    String           // Numéro Mobile Money du bénéficiaire
  provider       String           // ex: "MTN_MOMO", "MOOV_BENIN"
  status         WithdrawalStatus @default(PENDING)
  adminNote      String?

  user           User             @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("withdrawal_requests")
}